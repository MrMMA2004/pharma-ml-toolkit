# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
# the part13 Phase-3 component-test lane's setup directory — the
# bare `test` rule above would swallow it (vitest.config.ts references
# src/test/setup.ts; a fresh CI clone needs it tracked)
!pharma-ml-toolkit/frontend/src/test/

server.log
# Skills directory
/skills/tool-results/
tool-results/

# Token-bearing prompt files (contain GitHub PATs) — never commit
upload/Command.txt
upload/Command.docx
upload/MASTER_PROMPT.docx
# 2026-11-12 security hardening: the two vectors that actually leaked
# (part1 PDF §12.1 carries the PAT font-encoded; so does its text extraction)
upload/MASTER_PROMPT part*.pdf
scratch/pdf-extract/MASTER_PROMPT*.txt
# r340 hygiene: the owner's part-prompt copies are disk-only by
# convention (part15 arrived as .txt; part14.txt lives in scratch/) —
# the patterns keep any future `git add -A` from sweeping them into the
# push lane (the r337/r338 recovery precedent: restored-from-capture,
# never auto-committed).
upload/MASTER_PROMPT part*.txt
scratch/part*.txt
*.token
*.key
*.pid

# 2026-11-17 hardening: automated cron snapshot commits (webDevReview) once
# committed .credentials/github_pat wholesale (leaked-commit f2607a2, purged
# locally before any push). Never let that happen again.
.credentials/

# python build cache (r260 guard)
__pycache__/
*.pyc

# r272: the root dist-archive/ is home 5 of the six-home zip ritual
# (the task-text home) -- a local mirror, deliberately untracked like
# the offsite ~/pharma-ml-toolkit-zips/ mirror.
/dist-archive/

# 2026-11-19 (6th-rollback recovery): the ROOT MASTER_PROMPT.pdf also carries the font-encoded PAT
upload/MASTER_PROMPT.pdf

# the 600-mode e2e session token (the r318 ghost-sweep class — never commit)
scratch/e2e311_token.txt

# credential hygiene (r329): the owner's token uploads + the splice target stay DISK-ONLY
upload/GitHub_token.pdf
upload/GitHub_token.txt
.credentials/

# owner-directive hygiene (r335): upload/skill.txt is the standing ECC directive,
# disk-only like the token uploads (owner files are never auto-committed)
upload/skill.txt

# owner-document hygiene (r355, the پروژه فناوری.zip bundle restoration):
# the owner's commissioning documents stay DISK-ONLY in the upload/ document
# home (the R34 Design System pair, the R293 part11 Blocker Register, and the
# bundle zip itself) — never auto-committed, like the part-prompt PDFs above.
upload/Design System.pdf
upload/Design System.svg
upload/PharmaML_Studio_part11_Blocker_Register.pdf
upload/پروژه فناوری.zip
