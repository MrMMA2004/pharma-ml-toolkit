{
  "name": "pharmaml-studio-frontend",
  "private": true,
  "version": "1.2.229",
  "description": "PharmaML Studio \u2014 the offline React + TypeScript SPA (part11 Phase Three). Production builds are static assets loaded by the Tauri 2 host through WebView2; no dev server, no remote URL, no CDN.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript ../contracts/openapi.json --output src/types/api.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "plotly.js-dist-min": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.10"
  }
}
